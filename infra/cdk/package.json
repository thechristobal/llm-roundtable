{
  "name": "roundtable-cdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AWS CDK app for the hosted Roundtable demo — permanent stack (S3+CloudFront) and ephemeral demo-api stack",
  "bin": {
    "roundtable-cdk": "bin/app.js"
  },
  "scripts": {
    "build": "tsc",
    "synth:permanent": "cdk synth RoundtablePermanent",
    "synth:demo-api": "cdk synth RoundtableDemoApi",
    "diff": "cdk diff",
    "deploy:permanent": "cdk deploy RoundtablePermanent --require-approval=any-change",
    "deploy:demo-api": "cdk deploy RoundtableDemoApi --require-approval=any-change",
    "deploy-demo": "node --import tsx/esm bin/deploy-demo.ts",
    "destroy:demo-api": "cdk destroy RoundtableDemoApi --force",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.650.0",
    "@aws-sdk/client-cloudfront": "^3.650.0",
    "@aws-sdk/client-s3": "^3.650.0",
    "@aws-sdk/client-ssm": "^3.650.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.0.0",
    "aws-cdk": "^2.170.0",
    "esbuild": "^0.24.0",
    "source-map-support": "^0.5.21",
    "tsx": "^4.19.2",
    "typescript": "~5.6.0"
  }
}
