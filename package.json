    "@electron-forge/plugin-vite": "^7.7.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.24.2",
    "typescript": "~5.6.0"
  },
  "dependencies": {
    "electron": "^33.3.1",
    "electron-updater": "^6.3.0"
  }
}
