{
  "name": "llm-roundtable",
  "version": "1.0.0",
  "private": true,
  "description": "ChatGPT, Claude, and Gemini debate in parallel",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
