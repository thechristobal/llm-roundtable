{
  "name": "llm-roundtable",
  "version": "1.0.2",
  "private": true,
  "description": "ChatGPT, Claude, and Gemini debate in parallel",
  "author": "Christobal",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
